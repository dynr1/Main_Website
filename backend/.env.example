PORT=4000

# Postgres connection (Vercel Postgres / Neon).
# If you use Vercel's own Postgres storage integration, this (and a few
# related POSTGRES_* vars) gets set automatically when you link it to the
# project — you won't need to fill it in by hand for production.
# For local development, get this connection string from your Neon/Vercel
# Postgres dashboard and paste it here.
POSTGRES_URL=postgres://user:password@host:5432/dbname?sslmode=require

# SMTP settings — e.g. from Resend, Postmark, SendGrid, or Gmail app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=adeshar20@gmail.com
SMTP_PASS=checkpassword1234

MAIL_FROM="dynR Website <no-reply@dynr.co.uk>"
MAIL_TO=hello@dynr.co.uk
ADMIN_EMAIL=adeshar20@gmail.com
ADMIN_PASSWORD=checkpassword
JWT_SECRET=xk29fjLp92mVnq8rTz41BhWy9qLmZp3

# Used to build links in emails (password reset, Stripe checkout redirects).
# Set this to your actual deployed frontend URL.
APP_URL=https://dynr.co.uk

# Stripe billing — leave blank until you've created a Stripe account,
# product, and price. The app runs fine without these; billing just
# won't be available until they're set.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=